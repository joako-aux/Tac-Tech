<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título principal -->
        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Gestión de Solicitud"
            android:textColor="#24568A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Tarjeta del Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etDeviceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Equipo / Dispositivo (Ej: Notebook HP)"
                android:inputType="text"
                android:padding="10dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Dirección de atención"
                android:inputType="textPostalAddress"
                android:padding="10dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etIssueDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="top"
                android:hint="¿Qué sucedió? Detalle de la falla"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSubmitOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#24568A"
                android:text="Guardar Solicitud"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Único Botón de Navegación conservado -->
        <Button
            android:id="@+id/btnBackToMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#24568A"
            android:text="Volver"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>