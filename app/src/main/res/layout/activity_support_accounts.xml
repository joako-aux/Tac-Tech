<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F5F7FA">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cuentas de técnicos"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#24568A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona la empresa" />

        <Spinner
            android:id="@+id/spSupportCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona el técnico" />

        <Spinner
            android:id="@+id/spSupportEmployee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etSupportUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nombre de usuario (mínimo 4 caracteres)"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etSupportPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña (mínimo 8 caracteres)"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnCreateSupportAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Crear cuenta de soporte" />

        <TextView
            android:id="@+id/tvSupportAccountMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnBackAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Volver al menú principal" />

    </LinearLayout>
</ScrollView>